// ============================================================================
// ARCHIVO: prisma/schema.prisma
// ESQUEMA MAESTRO UNIFICADO — SAAS CONTABLE, POS Y GESTIÓN DE INVENTARIOS
// PostgreSQL 16+ | Multi-Tenant RLS | Kardex CPP | Partida Doble
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS GLOBALES DEL SISTEMA
// ============================================================================

// --- Squad 1: Core & RBAC ---
enum TaxRegime {
  REGIMEN_SIMPLE
  RESPONSABLE_IVA
  NO_RESPONSABLE_IVA
  GRAN_CONTRIBUYENTE
  REGIMEN_ESPECIAL
}

enum DocumentType {
  CC
  CE
  TI
  NIT
  PP
  PEP
}

enum UserRole {
  OWNER
  ADMIN
  ACCOUNTANT
  WAREHOUSE_MANAGER
  CASHIER
}

// --- Squad 7: Terceros, Compras & Cartera ---
enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum PurchasePaymentType {
  CONTADO
  CREDITO
}

enum PurchaseStatus {
  RECEIVED
  VOIDED
}

enum CreditTransactionType {
  CHARGE_CREDIT_SALE
  CUSTOMER_PAYMENT
  SUPPLIER_PURCHASE
  SUPPLIER_PAYMENT
  VOID_REVERSAL
}

enum CreditPaymentMethod {
  EFECTIVO
  NEQUI
  DAVIPLATA
  TARJETA
  TRANSFERENCIA
}

// --- Squad 2: Motor Contable ---
enum AccountType {
  ACTIVO
  PASIVO
  PATRIMONIO
  INGRESO
  GASTO
  COSTO
}

enum AccountNature {
  D
  C
}

enum JournalSourceDocumentType {
  SALE_POS
  PURCHASE
  CUSTOMER_PAYMENT
  SUPPLIER_PAYMENT
  REVERSAL
  SHRINKAGE
  MANUAL_ADJUSTMENT
  OPENING_BALANCE
  INVENTORY_MOVEMENT
}

// --- Squad 4 & 6: POS & Facturación ---
enum PosShiftStatus {
  OPEN
  CLOSED
  RECONCILED
}

enum InvoicePaymentMethod {
  EFECTIVO
  NEQUI
  DAVIPLATA
  TARJETA
  CREDITO_FIADO
  MIXTO
}

enum InvoiceStatus {
  ISSUED
  VOIDED
}

// --- Squad 3: Motor de Inventario & Kardex ---
enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductType {
  STOCKABLE
  SERVICE
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MovementType {
  PURCHASE_RECEIPT
  SALE_DISPATCH
  TRANSFER_IN
  TRANSFER_OUT
  SHRINKAGE_LOSS
  DAMAGE_LOSS
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  VOID_RETURN
}

enum MovementStatus {
  DRAFT
  POSTED
  REVERSED
}

enum MovementSource {
  POS
  PURCHASE
  TRANSFER
  ADJUSTMENT
  STOCK_COUNT
  RETURN
  SYSTEM
}

enum ReferenceType {
  POS_SALE
  POS_VOID
  PURCHASE
  PURCHASE_RETURN
  TRANSFER
  STOCK_COUNT
  MANUAL_ADJUSTMENT
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  OTHER
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
  REVERSED
}

enum BarcodeType {
  EAN13
  EAN8
  UPC
  CODE128
  INTERNAL
  OTHER
}

enum CostMethod {
  WEIGHTED_AVERAGE
}

enum AdjustmentReason {
  INITIAL_STOCK
  STOCK_COUNT
  DAMAGE
  LOSS
  FOUND
  CORRECTION
  OTHER
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockCountLineStatus {
  PENDING
  COUNTED
  APPLIED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  POST
  REVERSE
  TRANSFER
  ADJUST
  STOCK_COUNT
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum UnitType {
  UNIT
  LENGTH
  WEIGHT
  VOLUME
  PACKAGE
  OTHER
}

// ============================================================================
// CAPA 1: MODELO RAÍZ — EMPRESAS (TENANTS)
// ============================================================================

model Tenant {
  id           String    @id @default(uuid()) @db.Uuid
  nitRut       String    @unique @map("nit_rut") @db.VarChar(20)
  businessName String    @map("business_name") @db.VarChar(150)
  tradeName    String    @map("trade_name") @db.VarChar(150)
  address      String    @db.VarChar(200)
  phone        String    @db.VarChar(50)
  email        String    @db.VarChar(100)
  countryCode  String    @default("COL") @map("country_code") @db.VarChar(3)
  currencyCode String    @default("COP") @map("currency_code") @db.VarChar(3)
  taxRegime    TaxRegime @default(REGIMEN_SIMPLE) @map("tax_regime")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones Core
  branches        Branch[]
  users           User[]
  auditLogs       AuditLog[]
  tenantSequences TenantSequence[]

  // Relaciones Terceros, Compras & Cartera (E7)
  thirdParties       ThirdParty[]
  purchases          Purchase[]
  purchaseItems      PurchaseItem[]
  creditTransactions CreditTransaction[]

  // Relaciones Motor Contable (E2)
  chartOfAccounts   ChartOfAccount[]
  journalEntries    JournalEntry[]
  journalEntryLines JournalEntryLine[]

  // Relaciones POS & Facturación (E4/E6)
  posShifts    PosShift[]
  invoices     Invoice[]
  invoiceItems InvoiceItem[]

  // Relaciones Motor de Inventario & Kardex (E3)
  productCategories        ProductCategory[]
  unitOfMeasures           UnitOfMeasure[]
  products                 Product[]
  productVariants          ProductVariant[]
  productBarcodes          ProductBarcode[]
  warehouses               Warehouse[]
  inventoryBalances        InventoryBalance[]
  inventoryMovements       InventoryMovement[]
  inventoryMovementLines   InventoryMovementLine[]
  inventoryLedgerEntries   InventoryLedgerEntry[]
  inventoryTransfers       InventoryTransfer[]
  inventoryTransferLines   InventoryTransferLine[]
  stockCounts              StockCount[]
  stockCountLines          StockCountLine[]
  inventoryIdempotencyKeys InventoryIdempotencyKey[]
  inventoryOutboxEvents    InventoryOutboxEvent[]
  inventoryAuditLogs       InventoryAuditLog[]

  @@map("tenants")
}

// ============================================================================
// CAPA 2: ESTRUCTURA CORE, TERCEROS Y PLAN CONTABLE
// ============================================================================

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(20)
  name      String   @db.VarChar(100)
  address   String?  @db.VarChar(200)
  phone     String?  @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users          User[]
  warehouses     Warehouse[]
  journalEntries JournalEntry[]
  posShifts      PosShift[]
  invoices       Invoice[]
  purchases      Purchase[]

  @@unique([tenantId, code], map: "uq_tenant_branch_code")
  @@unique([tenantId, id], map: "uq_branches_tenant_id")
  @@map("branches")
}

model ThirdParty {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  documentType   DocumentType @default(CC) @map("document_type")
  documentNumber String       @map("document_number") @db.VarChar(20)
  name           String       @db.VarChar(150)
  phone          String?      @db.VarChar(50)
  email          String?      @db.VarChar(100)
  address        String?      @db.VarChar(200)
  partyType      PartyType    @map("party_type")
  creditLimit    Decimal      @default(0.00) @map("credit_limit") @db.Decimal(15, 2)
  currentDebt    Decimal      @default(0.00) @map("current_debt") @db.Decimal(15, 2)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntryLines  JournalEntryLine[]
  invoices           Invoice[]
  purchases          Purchase[]
  creditTransactions CreditTransaction[]

  @@unique([tenantId, documentType, documentNumber], map: "uq_tenant_third_party_doc")
  @@unique([tenantId, id], map: "uq_third_parties_tenant_id")
  @@map("third_parties")
}

model ChartOfAccount {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  code         String        @db.VarChar(20)
  name         String        @db.VarChar(150)
  accountType  AccountType   @map("account_type")
  nature       AccountNature
  parentId     String?       @map("parent_id") @db.Uuid
  isSelectable Boolean       @default(true) @map("is_selectable")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent            ChartOfAccount?    @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          ChartOfAccount[]   @relation("AccountHierarchy")
  journalEntryLines JournalEntryLine[]

  @@unique([tenantId, code], map: "uq_tenant_account_code")
  @@unique([tenantId, id], map: "uq_chart_tenant_id")
  @@index([tenantId, accountType], map: "idx_chart_tenant_type")
  @@map("chart_of_accounts")
}

// ============================================================================
// CAPA 3: CATÁLOGO DE PRODUCTOS E INVENTARIO (SQUAD 3)
// ============================================================================

model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  parentId    String?  @map("parent_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, name], map: "uq_tenant_category_name")
  @@unique([tenantId, id], map: "uq_product_categories_tenant_id")
  @@index([tenantId, parentId], map: "idx_category_tenant_parent")
  @@map("product_categories")
}

model UnitOfMeasure {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  code             String   @db.VarChar(20)
  name             String   @db.VarChar(50)
  symbol           String   @db.VarChar(10)
  unitType         UnitType @map("unit_type")
  decimalPlaces    Int      @default(3) @map("decimal_places")
  conversionFactor Decimal  @default(1.000000) @map("conversion_factor") @db.Decimal(18, 6)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products      Product[]
  variants      ProductVariant[]
  movementLines InventoryMovementLine[]

  @@unique([tenantId, code], map: "uq_tenant_uom_code")
  @@unique([tenantId, id], map: "uq_unit_of_measures_tenant_id")
  @@index([tenantId, unitType], map: "idx_uom_tenant_type")
  @@map("unit_of_measures")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  sku             String        @db.VarChar(50)
  name            String        @db.VarChar(150)
  description     String?       @db.Text
  barcode         String?       @db.VarChar(50)
  categoryId      String?       @map("category_id") @db.Uuid
  productType     ProductType   @default(STOCKABLE) @map("product_type")
  status          ProductStatus @default(ACTIVE)
  costPrice       Decimal       @default(0.000000) @map("cost_price") @db.Decimal(18, 6)
  salePrice       Decimal       @default(0.00) @map("sale_price") @db.Decimal(15, 2)
  wholesalePrice  Decimal?      @map("wholesale_price") @db.Decimal(15, 2)
  taxRate         Decimal       @default(0.19) @map("tax_rate") @db.Decimal(5, 2)
  minStockAlert   Decimal       @default(5.000000) @map("min_stock_alert") @db.Decimal(18, 6)
  unitOfMeasureId String        @map("unit_of_measure_id") @db.Uuid
  costMethod      CostMethod    @default(WEIGHTED_AVERAGE) @map("cost_method")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitOfMeasure     UnitOfMeasure           @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  variants          ProductVariant[]
  barcodes          ProductBarcode[]
  inventoryBalances InventoryBalance[]
  movementLines     InventoryMovementLine[]
  ledgerEntries     InventoryLedgerEntry[]
  transferLines     InventoryTransferLine[]
  stockCountLines   StockCountLine[]
  invoiceItems      InvoiceItem[]
  purchaseItems     PurchaseItem[]

  @@unique([tenantId, sku], map: "uq_tenant_product_sku")
  @@unique([tenantId, id], map: "uq_products_tenant_id")
  @@index([tenantId, barcode], map: "idx_products_tenant_barcode")
  @@index([tenantId, categoryId], map: "idx_products_tenant_category")
  @@map("products")
}

model ProductVariant {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  productId       String               @map("product_id") @db.Uuid
  sku             String               @db.VarChar(50)
  name            String               @db.VarChar(150)
  description     String?              @db.Text
  status          ProductVariantStatus @default(ACTIVE)
  costPrice       Decimal              @default(0.000000) @map("cost_price") @db.Decimal(18, 6)
  salePrice       Decimal              @default(0.00) @map("sale_price") @db.Decimal(15, 2)
  wholesalePrice  Decimal?             @map("wholesale_price") @db.Decimal(15, 2)
  taxRate         Decimal              @default(0.19) @map("tax_rate") @db.Decimal(5, 2)
  minStockAlert   Decimal              @default(5.000000) @map("min_stock_alert") @db.Decimal(18, 6)
  unitOfMeasureId String               @map("unit_of_measure_id") @db.Uuid
  isDefault       Boolean              @default(false) @map("is_default")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt      DateTime?            @map("archived_at") @db.Timestamptz

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitOfMeasure     UnitOfMeasure           @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  barcodes          ProductBarcode[]
  inventoryBalances InventoryBalance[]
  movementLines     InventoryMovementLine[]
  ledgerEntries     InventoryLedgerEntry[]
  transferLines     InventoryTransferLine[]
  stockCountLines   StockCountLine[]
  invoiceItems      InvoiceItem[]
  purchaseItems     PurchaseItem[]

  @@unique([tenantId, sku], map: "uq_tenant_variant_sku")
  @@unique([tenantId, id], map: "uq_product_variants_tenant_id")
  @@index([tenantId, productId], map: "idx_variants_tenant_product")
  @@map("product_variants")
}

model ProductBarcode {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  barcode   String      @db.VarChar(50)
  type      BarcodeType @default(INTERNAL)
  productId String?     @map("product_id") @db.Uuid
  variantId String?     @map("variant_id") @db.Uuid
  isPrimary Boolean     @default(false) @map("is_primary")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, barcode], map: "uq_tenant_barcode")
  @@unique([tenantId, id], map: "uq_product_barcodes_tenant_id")
  @@index([tenantId, productId], map: "idx_barcodes_tenant_product")
  @@index([tenantId, variantId], map: "idx_barcodes_tenant_variant")
  @@map("product_barcodes")
}

// ============================================================================
// CAPA 4: USUARIOS, BODEGAS, BALANCES Y TRASLADOS
// ============================================================================

model User {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  branchId       String?      @map("branch_id") @db.Uuid
  documentType   DocumentType @default(CC) @map("document_type")
  documentNumber String       @map("document_number") @db.VarChar(20)
  email          String       @db.VarChar(120)
  passwordHash   String       @map("password_hash") @db.VarChar(255)
  fullName       String       @map("full_name") @db.VarChar(120)
  phone          String?      @db.VarChar(50)
  role           UserRole
  isActive       Boolean      @default(true) @map("is_active")
  lastLoginAt    DateTime?    @map("last_login_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  auditLogs              AuditLog[]
  inventoryAuditLogs     InventoryAuditLog[] @relation("InventoryAuditLogPerformedBy")
  journalEntriesCreated  JournalEntry[]      @relation("JournalCreatedBy")
  shiftsAsCashier        PosShift[]          @relation("ShiftCashier")
  shiftsClosed           PosShift[]          @relation("ShiftClosedBy")
  invoicesCreated        Invoice[]           @relation("InvoiceCreatedBy")
  invoicesVoided         Invoice[]           @relation("InvoiceVoidedBy")
  purchasesCreated       Purchase[]          @relation("PurchaseCreatedBy")
  creditTxCreated        CreditTransaction[] @relation("CreditTxCreatedBy")
  movementsCreated       InventoryMovement[] @relation("MovementCreatedBy")
  movementsPosted        InventoryMovement[] @relation("MovementPostedBy")
  movementsReversed      InventoryMovement[] @relation("MovementReversedBy")
  transfersCreated       InventoryTransfer[] @relation("TransferCreatedBy")
  transfersCompleted     InventoryTransfer[] @relation("TransferCompletedBy")
  stockCountsCreated     StockCount[]        @relation("StockCountCreatedBy")
  stockCountsCompleted   StockCount[]        @relation("StockCountCompletedBy")
  stockCountLinesCounted StockCountLine[]    @relation("StockCountLineCountedBy")

  @@unique([tenantId, email], map: "uq_tenant_user_email")
  @@unique([tenantId, documentNumber], map: "uq_tenant_user_doc")
  @@unique([tenantId, id], map: "uq_users_tenant_id")
  @@index([tenantId, role], map: "idx_users_tenant_role")
  @@index([tenantId, branchId], map: "idx_users_tenant_branch")
  @@map("users")
}

model Warehouse {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  branchId    String          @map("branch_id") @db.Uuid
  code        String          @db.VarChar(20)
  name        String          @db.VarChar(100)
  description String?         @db.Text
  status      WarehouseStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz

  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryBalances    InventoryBalance[]
  sourceTransfers      InventoryTransfer[]    @relation("TransferSourceWarehouse")
  destinationTransfers InventoryTransfer[]    @relation("TransferDestinationWarehouse")
  movements            InventoryMovement[]
  ledgerEntries        InventoryLedgerEntry[]
  stockCounts          StockCount[]
  purchases            Purchase[]

  @@unique([tenantId, code], map: "uq_tenant_warehouse_code")
  @@unique([tenantId, id], map: "uq_warehouses_tenant_id")
  @@index([tenantId, branchId], map: "idx_warehouses_tenant_branch")
  @@map("warehouses")
}

model InventoryBalance {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  quantityOnHand   Decimal  @default(0.000000) @map("quantity_on_hand") @db.Decimal(18, 6)
  reservedQuantity Decimal  @default(0.000000) @map("reserved_quantity") @db.Decimal(18, 6)
  averageCost      Decimal  @default(0.000000) @map("average_cost") @db.Decimal(18, 6)
  inventoryValue   Decimal  @default(0.0000) @map("inventory_value") @db.Decimal(20, 4)
  version          BigInt   @default(0)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, variantId, warehouseId], map: "uq_tenant_variant_warehouse")
  @@unique([tenantId, id], map: "uq_inventory_balances_tenant_id")
  @@index([tenantId, productId, warehouseId], map: "idx_balances_product_warehouse")
  @@map("inventory_balances")
}

model InventoryTransfer {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  sourceWarehouseId      String         @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String         @map("destination_warehouse_id") @db.Uuid
  status                 TransferStatus @default(DRAFT)
  referenceDocument      String?        @map("reference_document") @db.VarChar(100)
  reason                 String?        @db.Text
  createdById            String?        @map("created_by_id") @db.Uuid
  completedById          String?        @map("completed_by_id") @db.Uuid
  outboundMovementId     String?        @unique @map("outbound_movement_id") @db.Uuid
