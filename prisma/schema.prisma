  @@unique([tenantId, id], map: "uq_purchase_items_tenant_id")
  @@index([purchaseId], map: "idx_purchase_items_purchase")
  @@map("purchase_items")
}

model CreditTransaction {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  thirdPartyId     String                @map("third_party_id") @db.Uuid
  transactionType  CreditTransactionType @map("transaction_type")
  sourceDocumentId String?               @map("source_document_id") @db.Uuid
  amount           Decimal               @db.Decimal(15, 2)
  balanceAfter     Decimal               @map("balance_after") @db.Decimal(15, 2)
  paymentMethod    CreditPaymentMethod   @default(EFECTIVO) @map("payment_method")
  receiptNumber    String?               @map("receipt_number") @db.VarChar(50)
  notes            String?               @db.Text
  journalEntryId   String?               @map("journal_entry_id") @db.Uuid
  createdBy        String                @map("created_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  thirdParty   ThirdParty    @relation(fields: [thirdPartyId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  creator      User          @relation("CreditTxCreatedBy", fields: [createdBy], references: [id])

  @@unique([tenantId, id], map: "uq_credit_tx_tenant_id")
  @@index([tenantId, thirdPartyId, createdAt], map: "idx_credit_tx_tenant_third")
  @@map("credit_transactions")
}

// ============================================================================
// CAPA 7: RESILIENCIA, AUDITORÍA & EVENT-DRIVEN (SQUAD 1 & SQUAD 3)
// ============================================================================

model TenantSequence {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  sequenceKey  String @map("sequence_key") @db.VarChar(50)
  currentValue BigInt @default(0) @map("current_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, sequenceKey], map: "uq_tenant_sequence")
  @@unique([tenantId, id], map: "uq_tenant_sequences_tenant_id")
  @@map("tenant_sequences")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(50)
  entityName String   @map("entity_name") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(300)
  details    Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tenantId, id], map: "uq_audit_logs_tenant_id")
  @@index([tenantId, entityName, entityId], map: "idx_audit_tenant_entity")
  @@map("audit_logs")
}

model InventoryIdempotencyKey {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  key          String    @db.VarChar(150)
  operation    String    @db.VarChar(100)
  requestHash  String    @map("request_hash") @db.VarChar(128)
  statusCode   Int?      @map("status_code")
  responseBody Json?     @map("response_body") @db.JsonB
  resourceType String?   @map("resource_type") @db.VarChar(100)
  resourceId   String?   @map("resource_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], map: "uq_inventory_idempotency_key")
  @@unique([tenantId, id], map: "uq_inventory_idempotency_tenant_id")
  @@map("inventory_idempotency_keys")
}

model InventoryOutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  eventType     String            @map("event_type") @db.VarChar(100)
  aggregateType String            @map("aggregate_type") @db.VarChar(100)
  aggregateId   String            @map("aggregate_id") @db.Uuid
  payload       Json              @db.JsonB
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now()) @map("available_at") @db.Timestamptz
  processedAt   DateTime?         @map("processed_at") @db.Timestamptz
  lastError     String?           @map("last_error") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id], map: "uq_inventory_outbox_tenant_id")
  @@index([tenantId, status, availableAt], map: "idx_outbox_tenant_status")
  @@map("inventory_outbox_events")
}

model InventoryAuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  action        AuditAction
  entityType    String      @map("entity_type") @db.VarChar(100)
  entityId      String      @map("entity_id") @db.Uuid
  movementId    String?     @map("movement_id") @db.Uuid
  performedById String?     @map("performed_by_id") @db.Uuid
  oldValues     Json?       @map("old_values") @db.JsonB
  newValues     Json?       @map("new_values") @db.JsonB
  reason        String?     @db.Text
  ipAddress     String?     @map("ip_address") @db.VarChar(64)
  userAgent     String?     @map("user_agent") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movement    InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)
  performedBy User?              @relation("InventoryAuditLogPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, id], map: "uq_inventory_audit_tenant_id")
  @@index([tenantId, entityType, entityId], map: "idx_inv_audit_entity")
  @@map("inventory_audit_logs")
}
