// ============================================================================
// REFERENCIA DE INTEGRACIÓN: SQUAD 1 (CORE) + SQUAD 3 (INVENTORY ENGINE)
// ============================================================================
// NOTA IMPORTANTE:
// Este archivo es ÚNICAMENTE una referencia de integración arquitectónica entre
// el Escuadrón 1 (Core / Multi-Tenancy / RBAC) y el Escuadrón 3 (Inventarios / Kardex).
//
// 1. NO reemplaza a 'schema.prisma' (el esquema general completo del SaaS).
// 2. NO debe utilizarse directamente para ejecutar migraciones en la base de datos.
// 3. Los modelos pertenecientes exclusivamente a otros escuadrones (E2 Contabilidad,
//    E4 POS, E6 Facturación/Anulaciones, E7 Compras/Cartera) fueron omitidos
//    intencionalmente para focalizar la coordinación técnica entre E1 y E3.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"
}

// ============================================================================
// ENUMS (DOMINIO E3 - INVENTORY ENGINE)
// ============================================================================

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductType {
  STOCKABLE
  SERVICE
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MovementType {
  PURCHASE_RECEIPT
  SALE_DISPATCH
  TRANSFER_IN
  TRANSFER_OUT
  SHRINKAGE_LOSS
  DAMAGE_LOSS
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  VOID_RETURN
}

enum MovementStatus {
  DRAFT
  POSTED
  REVERSED
}

enum MovementSource {
  POS
  PURCHASE
  TRANSFER
  ADJUSTMENT
  STOCK_COUNT
  RETURN
  SYSTEM
}

enum ReferenceType {
  POS_SALE
  POS_VOID
  PURCHASE
  PURCHASE_RETURN
  TRANSFER
  STOCK_COUNT
  MANUAL_ADJUSTMENT
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  OTHER
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
  REVERSED
}

enum BarcodeType {
  EAN13
  EAN8
  UPC
  CODE128
  INTERNAL
  OTHER
}

enum CostMethod {
  WEIGHTED_AVERAGE
}

enum AdjustmentReason {
  INITIAL_STOCK
  STOCK_COUNT
  DAMAGE
  LOSS
  FOUND
  CORRECTION
  OTHER
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockCountLineStatus {
  PENDING
  COUNTED
  APPLIED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  POST
  REVERSE
  TRANSFER
  ADJUST
  STOCK_COUNT
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum UnitType {
  UNIT
  LENGTH
  WEIGHT
  VOLUME
  PACKAGE
  OTHER
}

// ============================================================================
// MODELOS E1 (CORE) REQUERIDOS POR E3
// ============================================================================

// ----------------------------------------------------------------------------
// E1: TENANT
// Propietario: Squad 1
// Consumido por: Todos los modelos de E3 para aislamiento multi-tenant estricto
// ----------------------------------------------------------------------------
model Tenant {
  id           String    @id @default(uuid()) @db.Uuid
  nitRut       String    @unique @map("nit_rut") @db.VarChar(20)
  businessName String    @map("business_name") @db.VarChar(150)
  tradeName    String    @map("trade_name") @db.VarChar(150)
  address      String    @db.VarChar(200)
  phone        String    @db.VarChar(50)
  email        String    @db.VarChar(100)
  countryCode  String?   @default("COL") @map("country_code") @db.VarChar(3)
  currencyCode String?   @default("COP") @map("currency_code") @db.VarChar(3)
  taxRegime    String?   @default("REGIMEN_SIMPLE") @map("tax_regime") @db.VarChar(30)
  isActive     Boolean?  @default(true) @map("is_active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones Core E1 presentes en esta vista
  branches Branch[]
  users    User[]

  // Relaciones hacia el dominio de Inventario (E3)
  productCategories        ProductCategory[]
  unitOfMeasures           UnitOfMeasure[]
  products                 Product[]
  productVariants          ProductVariant[]
  productBarcodes          ProductBarcode[]
  warehouses               Warehouse[]
  inventoryBalances        InventoryBalance[]
  inventoryMovements       InventoryMovement[]
  inventoryMovementLines   InventoryMovementLine[]
  inventoryLedgerEntries   InventoryLedgerEntry[]
  inventoryTransfers       InventoryTransfer[]
  inventoryTransferLines   InventoryTransferLine[]
  stockCounts              StockCount[]
  stockCountLines          StockCountLine[]
  inventoryIdempotencyKeys InventoryIdempotencyKey[]
  inventoryOutboxEvents    InventoryOutboxEvent[]
  inventoryAuditLogs       InventoryAuditLog[]

  // NOTA: Colecciones de otros squads (E2, E4, E6, E7) omitidas de este esquema de referencia.

  @@map("tenants")
}

// ----------------------------------------------------------------------------
// E1: BRANCH (SUCURSAL)
// Propietario: Squad 1
// Consumido por: Warehouse (cada bodega física o lógica pertenece a una sucursal)
// ----------------------------------------------------------------------------
model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String    @db.VarChar(20)
  name      String    @db.VarChar(100)
  address   String?   @db.VarChar(200)
  phone     String?   @db.VarChar(50)
  isActive  Boolean?  @default(true) @map("is_active")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users      User[]
  warehouses Warehouse[]

  @@unique([tenantId, code], map: "uq_tenant_branch_code")
  @@map("branches")
}

// ----------------------------------------------------------------------------
// E1: USER (USUARIO / AUDITORÍA OPERACIONAL)
// Propietario: Squad 1
// Consumido por: E3 para firmas de autor, aprobación, conteos y auditoría
// ----------------------------------------------------------------------------
model User {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  documentType   String    @default("CC") @map("document_type") @db.VarChar(10)
  documentNumber String    @map("document_number") @db.VarChar(20)
  email          String    @db.VarChar(120)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  fullName       String    @map("full_name") @db.VarChar(120)
  phone          String?   @db.VarChar(50)
  role           String    @db.VarChar(30)
  isActive       Boolean?  @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Firmas y trazabilidad operacional requeridas por E3 (Inventory Engine)
  movementsCreated       InventoryMovement[] @relation("MovementCreatedBy")
  movementsPosted        InventoryMovement[] @relation("MovementPostedBy")
  movementsReversed      InventoryMovement[] @relation("MovementReversedBy")
  transfersCreated       InventoryTransfer[] @relation("TransferCreatedBy")
  transfersCompleted     InventoryTransfer[] @relation("TransferCompletedBy")
  stockCountsCreated     StockCount[]        @relation("StockCountCreatedBy")
  stockCountsCompleted   StockCount[]        @relation("StockCountCompletedBy")
  stockCountLinesCounted StockCountLine[]    @relation("StockCountLineCountedBy")
  inventoryAuditLogs     InventoryAuditLog[] @relation("InventoryAuditLogPerformedBy")

  @@unique([tenantId, email], map: "uq_tenant_user_email")
  @@unique([tenantId, documentNumber], map: "uq_tenant_user_doc")
  @@index([tenantId, role], map: "idx_users_tenant_role")
  @@index([tenantId, branchId], map: "idx_users_tenant_branch")
  @@map("users")
}

// ============================================================================
// MODELOS E3 (INVENTORY ENGINE / MULTI-BODEGA / KARDEX CPP)
// Propietario: Squad 3
// ============================================================================

// ----------------------------------------------------------------------------
// E3: PRODUCT CATEGORY
// ----------------------------------------------------------------------------
model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  parentId    String?  @map("parent_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId, parentId])
  @@index([tenantId, isActive])
  @@map("product_categories")
}

// ----------------------------------------------------------------------------
// E3: UNIT OF MEASURE
// ----------------------------------------------------------------------------
model UnitOfMeasure {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  code             String   @db.VarChar(20)
  name             String   @db.VarChar(50)
  symbol           String   @db.VarChar(10)
  unitType         UnitType @map("unit_type")
  decimalPlaces    Int      @default(3) @map("decimal_places")
  conversionFactor Decimal  @default(1) @map("conversion_factor") @db.Decimal(18, 6)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products      Product[]
  variants      ProductVariant[]
  movementLines InventoryMovementLine[]

  @@unique([tenantId, code])
  @@index([tenantId, unitType])
  @@index([tenantId, isActive])
  @@map("unit_of_measures")
}

// ----------------------------------------------------------------------------
// E3: PRODUCT
// ----------------------------------------------------------------------------
model Product {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  sku             String        @db.VarChar(50)
  name            String        @db.VarChar(150)
  description     String?       @db.Text
  barcode         String?       @db.VarChar(50)
  categoryId      String?       @map("category_id") @db.Uuid
  productType     ProductType   @default(STOCKABLE) @map("product_type")
  status          ProductStatus @default(ACTIVE)
  costPrice       Decimal       @default(0) @map("cost_price") @db.Decimal(15, 4)
  salePrice       Decimal       @default(0) @map("sale_price") @db.Decimal(15, 2)
  wholesalePrice  Decimal?      @map("wholesale_price") @db.Decimal(15, 2)
  taxRate         Decimal       @default(0.19) @map("tax_rate") @db.Decimal(5, 2)
  minStockAlert   Decimal       @default(5) @map("min_stock_alert") @db.Decimal(12, 3)
  unitOfMeasureId String        @map("unit_of_measure_id") @db.Uuid
  costMethod      CostMethod    @default(WEIGHTED_AVERAGE) @map("cost_method")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  archivedAt      DateTime?     @map("archived_at") @db.Timestamp(3)

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitOfMeasure     UnitOfMeasure           @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  variants          ProductVariant[]
  barcodes          ProductBarcode[]
  inventoryBalances InventoryBalance[]
  movementLines     InventoryMovementLine[]
  ledgerEntries     InventoryLedgerEntry[]
  transferLines     InventoryTransferLine[]
  stockCountLines   StockCountLine[]

  // NOTA DE INTEGRACIÓN EXTERNA:
  // En el esquema global existen colecciones de líneas de venta (E4/E6 InvoiceItem)
  // y líneas de compra (E7 PurchaseItem) que referencian este modelo.
  // Fueron omitidas de este archivo para delimitar el alcance E1 + E3.

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, unitOfMeasureId])
  @@index([tenantId, createdAt])
  @@map("products")
}

// ----------------------------------------------------------------------------
// E3: PRODUCT VARIANT
// ----------------------------------------------------------------------------
model ProductVariant {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  productId       String               @map("product_id") @db.Uuid
  sku             String               @db.VarChar(50)
  name            String               @db.VarChar(150)
  description     String?              @db.Text
  status          ProductVariantStatus @default(ACTIVE)
  costPrice       Decimal              @default(0) @map("cost_price") @db.Decimal(15, 4)
  salePrice       Decimal              @default(0) @map("sale_price") @db.Decimal(15, 2)
  wholesalePrice  Decimal?             @map("wholesale_price") @db.Decimal(15, 2)
  taxRate         Decimal              @default(0.19) @map("tax_rate") @db.Decimal(5, 2)
  minStockAlert   Decimal              @default(5) @map("min_stock_alert") @db.Decimal(12, 3)
  unitOfMeasureId String               @map("unit_of_measure_id") @db.Uuid
  isDefault       Boolean              @default(false) @map("is_default")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamp(3)
  archivedAt      DateTime?            @map("archived_at") @db.Timestamp(3)

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitOfMeasure     UnitOfMeasure           @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  barcodes          ProductBarcode[]
  inventoryBalances InventoryBalance[]
  movementLines     InventoryMovementLine[]
  ledgerEntries     InventoryLedgerEntry[]
  transferLines     InventoryTransferLine[]
  stockCountLines   StockCountLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@index([tenantId, status])
  @@index([tenantId, productId, isDefault])
  @@map("product_variants")
}

// ----------------------------------------------------------------------------
// E3: PRODUCT BARCODE
// ----------------------------------------------------------------------------
model ProductBarcode {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  barcode   String      @db.VarChar(50)
  type      BarcodeType @default(INTERNAL)
  productId String?     @map("product_id") @db.Uuid
  variantId String?     @map("variant_id") @db.Uuid
  isPrimary Boolean     @default(false) @map("is_primary")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, barcode])
  @@index([tenantId, productId])
  @@index([tenantId, variantId])
  @@index([tenantId, isActive])
  @@map("product_barcodes")
}

// ----------------------------------------------------------------------------
// E3: WAREHOUSE (BODEGA)
// ----------------------------------------------------------------------------
model Warehouse {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  branchId    String          @map("branch_id") @db.Uuid
  code        String          @db.VarChar(20)
  name        String          @db.VarChar(100)
  description String?         @db.Text
  status      WarehouseStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamp(3)
  archivedAt  DateTime?       @map("archived_at") @db.Timestamp(3)

  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryBalances    InventoryBalance[]
  sourceTransfers      InventoryTransfer[]    @relation("TransferSourceWarehouse")
  destinationTransfers InventoryTransfer[]    @relation("TransferDestinationWarehouse")
  movements            InventoryMovement[]
  ledgerEntries        InventoryLedgerEntry[]
  stockCounts          StockCount[]

  // NOTA DE INTEGRACIÓN EXTERNA:
  // En el esquema global existe una relación de Compras (E7 Purchase.warehouseId).
  // Fue omitida de este archivo para mantener el scope acotado a E1 + E3.

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("warehouses")
}

// ----------------------------------------------------------------------------
// E3: INVENTORY BALANCE
// ----------------------------------------------------------------------------
model InventoryBalance {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  quantityOnHand   Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(18, 6)
  reservedQuantity Decimal  @default(0) @map("reserved_quantity") @db.Decimal(18, 6)
  averageCost      Decimal  @default(0) @map("average_cost") @db.Decimal(18, 6)
  inventoryValue   Decimal  @default(0) @map("inventory_value") @db.Decimal(20, 4)
  version          BigInt   @default(0)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, variantId, warehouseId])
  @@index([tenantId, productId, warehouseId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, variantId])
  @@index([tenantId, warehouseId, quantityOnHand])
  @@map("inventory_balances")
}

// ----------------------------------------------------------------------------
// E3: INVENTORY MOVEMENT
// ----------------------------------------------------------------------------
model InventoryMovement {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  type               MovementType
  status             MovementStatus    @default(DRAFT)
  source             MovementSource
  warehouseId        String            @map("warehouse_id") @db.Uuid
  referenceType      ReferenceType?    @map("reference_type")
  referenceId        String?           @map("reference_id") @db.Uuid
  referenceDocument  String?           @map("reference_document") @db.VarChar(100)
  reason             String?           @db.Text
  adjustmentReason   AdjustmentReason? @map("adjustment_reason")
  createdById        String?           @map("created_by_id") @db.Uuid
  postedById         String?           @map("posted_by_id") @db.Uuid
  reversedById       String?           @map("reversed_by_id") @db.Uuid
  reversesMovementId String?           @unique @map("reverses_movement_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamp(3)
  postedAt           DateTime?         @map("posted_at") @db.Timestamp(3)
  reversedAt         DateTime?         @map("reversed_at") @db.Timestamp(3)

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse        Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy        User?                   @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy         User?                   @relation("MovementPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  reversedBy       User?                   @relation("MovementReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  reversesMovement InventoryMovement?      @relation("MovementReversal", fields: [reversesMovementId], references: [id], onDelete: Restrict)
  reversalOf       InventoryMovement?      @relation("MovementReversal")
  outboundTransfer InventoryTransfer?      @relation("TransferOutboundMovement")
  inboundTransfer  InventoryTransfer?      @relation("TransferInboundMovement")
  lines            InventoryMovementLine[]
  ledgerEntries    InventoryLedgerEntry[]
  auditLogs        InventoryAuditLog[]

  // NOTA DE DESACOPLAMIENTO:
  // referenceId y referenceDocument vinculan lógicamente esta transacción con documentos
  // de otros escuadrones (ej. Facturas POS de E4/E6, Facturas de compra de E7) sin acoplamiento rígido de FK.

  @@index([tenantId, warehouseId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, referenceType, referenceId])
  @@index([tenantId, referenceDocument])
  @@map("inventory_movements")
}

// ----------------------------------------------------------------------------
// E3: INVENTORY MOVEMENT LINE
// ----------------------------------------------------------------------------
model InventoryMovementLine {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  movementId           String   @map("movement_id") @db.Uuid
  lineNumber           Int      @map("line_number")
  productId            String   @map("product_id") @db.Uuid
  variantId            String   @map("variant_id") @db.Uuid
  unitOfMeasureId      String   @map("unit_of_measure_id") @db.Uuid
  quantity             Decimal  @db.Decimal(18, 6)
  unitCost             Decimal  @map("unit_cost") @db.Decimal(18, 6)
  totalCost            Decimal  @map("total_cost") @db.Decimal(20, 4)
  previousQuantity     Decimal  @map("previous_quantity") @db.Decimal(18, 6)
  newQuantity          Decimal  @map("new_quantity") @db.Decimal(18, 6)
  averageCostBefore    Decimal  @map("average_cost_before") @db.Decimal(18, 6)
  averageCostAfter     Decimal  @map("average_cost_after") @db.Decimal(18, 6)
  inventoryValueBefore Decimal  @map("inventory_value_before") @db.Decimal(20, 4)
  inventoryValueAfter  Decimal  @map("inventory_value_after") @db.Decimal(20, 4)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movement      InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  unitOfMeasure UnitOfMeasure     @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)

  @@unique([movementId, lineNumber])
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, variantId, createdAt])
  @@index([tenantId, movementId])
  @@map("inventory_movement_lines")
}

// ----------------------------------------------------------------------------
// E3: INVENTORY LEDGER / KARDEX (HISTÓRICO INMUTABLE)
// ----------------------------------------------------------------------------
model InventoryLedgerEntry {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  sequence             BigInt         @unique @default(autoincrement())
  movementId           String         @map("movement_id") @db.Uuid
  productId            String         @map("product_id") @db.Uuid
  variantId            String         @map("variant_id") @db.Uuid
  warehouseId          String         @map("warehouse_id") @db.Uuid
  movementType         MovementType   @map("movement_type")
  quantityIn           Decimal        @default(0) @map("quantity_in") @db.Decimal(18, 6)
  quantityOut          Decimal        @default(0) @map("quantity_out") @db.Decimal(18, 6)
  quantityDelta        Decimal        @map("quantity_delta") @db.Decimal(18, 6)
  quantityBalance      Decimal        @map("quantity_balance") @db.Decimal(18, 6)
  unitCost             Decimal        @map("unit_cost") @db.Decimal(18, 6)
  costDelta            Decimal        @map("cost_delta") @db.Decimal(20, 4)
  averageCostBefore    Decimal        @map("average_cost_before") @db.Decimal(18, 6)
  averageCostAfter     Decimal        @map("average_cost_after") @db.Decimal(18, 6)
  inventoryValueBefore Decimal        @map("inventory_value_before") @db.Decimal(20, 4)
  inventoryValueAfter  Decimal        @map("inventory_value_after") @db.Decimal(20, 4)
  referenceType        ReferenceType? @map("reference_type")
  referenceId          String?        @map("reference_id") @db.Uuid
  referenceDocument    String?        @map("reference_document") @db.VarChar(100)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamp(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movement  InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([tenantId, variantId, warehouseId, createdAt])
  @@index([tenantId, productId, warehouseId, createdAt])
  @@index([tenantId, movementId])
  @@index([tenantId, referenceType, referenceId])
  @@map("inventory_ledger_entries")
}

// ----------------------------------------------------------------------------
// E3: INVENTORY TRANSFER
// ----------------------------------------------------------------------------
model InventoryTransfer {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  sourceWarehouseId      String         @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String         @map("destination_warehouse_id") @db.Uuid
  status                 TransferStatus @default(DRAFT)
  referenceDocument      String?        @map("reference_document") @db.VarChar(100)
  reason                 String?        @db.Text
  createdById            String?        @map("created_by_id") @db.Uuid
  completedById          String?        @map("completed_by_id") @db.Uuid
  outboundMovementId     String?        @unique @map("outbound_movement_id") @db.Uuid
  inboundMovementId      String?        @unique @map("inbound_movement_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamp(3)
  completedAt            DateTime?      @map("completed_at") @db.Timestamp(3)

  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceWarehouse      Warehouse               @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse               @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  createdBy            User?                   @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy          User?                   @relation("TransferCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  outboundMovement     InventoryMovement?      @relation("TransferOutboundMovement", fields: [outboundMovementId], references: [id], onDelete: Restrict)
  inboundMovement      InventoryMovement?      @relation("TransferInboundMovement", fields: [inboundMovementId], references: [id], onDelete: Restrict)
  lines                InventoryTransferLine[]

  @@index([tenantId, sourceWarehouseId])
  @@index([tenantId, destinationWarehouseId])
  @@index([tenantId, status])
  @@index([tenantId, referenceDocument])
  @@map("inventory_transfers")
}

// ----------------------------------------------------------------------------
// E3: INVENTORY TRANSFER LINE
// ----------------------------------------------------------------------------
model InventoryTransferLine {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  transferId        String   @map("transfer_id") @db.Uuid
  lineNumber        Int      @map("line_number")
  productId         String   @map("product_id") @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  quantity          Decimal  @db.Decimal(18, 6)
  transferUnitCost  Decimal  @map("transfer_unit_cost") @db.Decimal(18, 6)
  transferTotalCost Decimal  @map("transfer_total_cost") @db.Decimal(20, 4)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([transferId, lineNumber])
  @@index([tenantId, productId])
  @@index([tenantId, variantId])
  @@map("inventory_transfer_lines")
}

// ----------------------------------------------------------------------------
// E3: STOCK COUNT (CONTEO FÍSICO DE INVENTARIO)
// ----------------------------------------------------------------------------
model StockCount {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  warehouseId       String           @map("warehouse_id") @db.Uuid
  status            StockCountStatus @default(DRAFT)
  referenceDocument String?          @map("reference_document") @db.VarChar(100)
  notes             String?          @db.Text
  createdById       String?          @map("created_by_id") @db.Uuid
  completedById     String?          @map("completed_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamp(3)
  startedAt         DateTime?        @map("started_at") @db.Timestamp(3)
  completedAt       DateTime?        @map("completed_at") @db.Timestamp(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User?            @relation("StockCountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy User?            @relation("StockCountCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  lines       StockCountLine[]

  @@index([tenantId, warehouseId])
  @@index([tenantId, status])
  @@index([tenantId, referenceDocument])
  @@map("stock_counts")
}

// ----------------------------------------------------------------------------
// E3: STOCK COUNT LINE
// ----------------------------------------------------------------------------
model StockCountLine {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  stockCountId       String               @map("stock_count_id") @db.Uuid
  productId          String               @map("product_id") @db.Uuid
  variantId          String               @map("variant_id") @db.Uuid
  systemQuantity     Decimal              @map("system_quantity") @db.Decimal(18, 6)
  countedQuantity    Decimal?             @map("counted_quantity") @db.Decimal(18, 6)
  differenceQuantity Decimal?             @map("difference_quantity") @db.Decimal(18, 6)
  status             StockCountLineStatus @default(PENDING)
  countedById        String?              @map("counted_by_id") @db.Uuid
  countedAt          DateTime?            @map("counted_at") @db.Timestamp(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockCount StockCount     @relation(fields: [stockCountId], references: [id], onDelete: Restrict)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  countedBy  User?          @relation("StockCountLineCountedBy", fields: [countedById], references: [id], onDelete: SetNull)

  @@unique([stockCountId, variantId])
  @@index([tenantId, productId])
  @@index([tenantId, variantId])
  @@map("stock_count_lines")
}

// ----------------------------------------------------------------------------
// E3: INVENTORY IDEMPOTENCY KEY
// ----------------------------------------------------------------------------
model InventoryIdempotencyKey {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  key          String    @db.VarChar(150)
  operation    String    @db.VarChar(100)
  requestHash  String    @map("request_hash") @db.VarChar(128)
  statusCode   Int?      @map("status_code")
  responseBody Json?     @map("response_body") @db.JsonB
  resourceType String?   @map("resource_type") @db.VarChar(100)
  resourceId   String?   @map("resource_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  expiresAt    DateTime? @map("expires_at") @db.Timestamp(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, operation])
  @@index([tenantId, resourceType, resourceId])
  @@index([expiresAt])
  @@map("inventory_idempotency_keys")
}

// ----------------------------------------------------------------------------
// E3: INVENTORY OUTBOX EVENT (PATRÓN TRANSACCIONAL EVENT-DRIVEN)
// ----------------------------------------------------------------------------
model InventoryOutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  eventType     String            @map("event_type") @db.VarChar(100)
  aggregateType String            @map("aggregate_type") @db.VarChar(100)
  aggregateId   String            @map("aggregate_id") @db.Uuid
  payload       Json              @db.JsonB
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now()) @map("available_at") @db.Timestamp(3)
  processedAt   DateTime?         @map("processed_at") @db.Timestamp(3)
  lastError     String?           @map("last_error") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([tenantId, eventType])
  @@map("inventory_outbox_events")
}

// ----------------------------------------------------------------------------
// E3: INVENTORY AUDIT LOG
// ----------------------------------------------------------------------------
model InventoryAuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  action        AuditAction
  entityType    String      @map("entity_type") @db.VarChar(100)
  entityId      String      @map("entity_id") @db.Uuid
  movementId    String?     @map("movement_id") @db.Uuid
  performedById String?     @map("performed_by_id") @db.Uuid
  oldValues     Json?       @map("old_values") @db.JsonB
  newValues     Json?       @map("new_values") @db.JsonB
  reason        String?     @db.Text
  ipAddress     String?     @map("ip_address") @db.VarChar(64)
  userAgent     String?     @map("user_agent") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamp(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movement    InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)
  performedBy User?              @relation("InventoryAuditLogPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, movementId])
  @@index([tenantId, performedById])
  @@index([tenantId, createdAt])
  @@map("inventory_audit_logs")
}

// ============================================================================
// INTEGRATION NOTES: COORDINACIÓN TÉCNICA E1 (CORE) <-> E3 (INVENTORY)
// ============================================================================
//
// 1. MODELOS DE E1 QUE E3 NECESITA CONSUMIR:
//    - Tenant (`tenants`):
//        * Obligatorio para todas las entidades de E3 (`tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE`).
//        * Permite la aplicación de políticas RLS transparentes en PostgreSQL.
//    - Branch (`branches`):
//        * Cada Warehouse de E3 pertenece a una Branch de E1 (`branch_id UUID NOT NULL REFERENCES branches(id) ON DELETE CASCADE`).
//        * Permite agrupar bodegas por sucursal física o canal de distribución.
//    - User (`users`):
//        * Firmas operacionales requeridas para auditoría inmutable e integridad:
//            - `InventoryMovement.created_by_id` -> User (ON DELETE SET NULL)
//            - `InventoryMovement.posted_by_id` -> User (ON DELETE SET NULL)
//            - `InventoryMovement.reversed_by_id` -> User (ON DELETE SET NULL)
//            - `InventoryTransfer.created_by_id` -> User (ON DELETE SET NULL)
//            - `InventoryTransfer.completed_by_id` -> User (ON DELETE SET NULL)
//            - `StockCount.created_by_id` -> User (ON DELETE SET NULL)
//            - `StockCount.completed_by_id` -> User (ON DELETE SET NULL)
//            - `StockCountLine.counted_by_id` -> User (ON DELETE SET NULL)
//            - `InventoryAuditLog.performed_by_id` -> User (ON DELETE SET NULL)
//
// 2. MODELOS DE E3 INCLUIDOS EN ESTE ESQUEMA (17 modelos):
//    - Catálogo: `ProductCategory`, `UnitOfMeasure`, `Product`, `ProductVariant`, `ProductBarcode`.
//    - Bodegas & Balances: `Warehouse`, `InventoryBalance`.
//    - Movimientos & Kardex: `InventoryMovement`, `InventoryMovementLine`, `InventoryLedgerEntry`.
//    - Traslados: `InventoryTransfer`, `InventoryTransferLine`.
//    - Conteo Físico: `StockCount`, `StockCountLine`.
//    - Concurrencia & Resiliencia: `InventoryIdempotencyKey`, `InventoryOutboxEvent`, `InventoryAuditLog`.
//
// 3. DEPENDENCIAS DE E3 HACIA OTROS SQUADS OMITIDAS EN ESTE DOCUMENTO:
//    - Squad 4/6 (POS & Facturación):
//        * `InvoiceItem.product_id -> Product`: Omitida la colección inversa `Product.invoiceItems`.
//        * En `InventoryMovement` y `InventoryLedgerEntry`, las ventas POS se referencian mediante
//          desacoplamiento lógico: `referenceType = POS_SALE`, `referenceId = invoice.id` (UUID).
//    - Squad 7 (Compras y Proveedores):
//        * `PurchaseItem.product_id -> Product`: Omitida la colección inversa `Product.purchaseItems`.
//        * `Purchase.warehouse_id -> Warehouse`: Omitida la colección inversa `Warehouse.purchases`.
//        * En `InventoryMovement`, las recepciones de compra se referencian mediante desacoplamiento lógico:
//          `referenceType = PURCHASE`, `referenceId = purchase.id` (UUID).
//    - Squad 2 (Motor Contable):
//        * Los asientos automáticos derivados del Kardex/Movimientos se generarán asíncronamente
//          a través de los eventos de `InventoryOutboxEvent` hacia `JournalEntry`, sin acoplamiento
//          transaccional directo de FK.
//    - Squad 1 (Core):
//        * Se omitió el modelo `AuditLog` global de E1, ya que E3 registra su trazabilidad detallada
//          a nivel de dominio en `InventoryAuditLog`.
//
// 4. CONSTRAINTS DE POSTGRESQL QUE REQUIEREN MIGRATION SQL EN E3:
//    - CHECK Barcode XOR:
//        ALTER TABLE product_barcodes ADD CONSTRAINT product_barcodes_product_or_variant_check
//        CHECK ((product_id IS NOT NULL AND variant_id IS NULL) OR (product_id IS NULL AND variant_id IS NOT NULL));
//    - CHECK Bodegas distintas en traslados:
//        ALTER TABLE inventory_transfers ADD CONSTRAINT inventory_transfers_different_warehouses_check
//        CHECK (source_warehouse_id <> destination_warehouse_id);
//    - CHECK Cantidades no negativas:
//        ALTER TABLE inventory_balances ADD CONSTRAINT inventory_balances_quantity_non_negative_check CHECK (quantity_on_hand >= 0);
//        ALTER TABLE inventory_balances ADD CONSTRAINT inventory_balances_reserved_non_negative_check CHECK (reserved_quantity >= 0);
//        ALTER TABLE inventory_movement_lines ADD CONSTRAINT inventory_movement_lines_quantity_positive_check CHECK (quantity > 0);
//        ALTER TABLE inventory_transfer_lines ADD CONSTRAINT inventory_transfer_lines_quantity_positive_check CHECK (quantity > 0);
//    - Índice Parcial (Un solo variant default activo por producto):
//        CREATE UNIQUE INDEX product_variants_one_default_per_product_idx
//        ON product_variants(tenant_id, product_id)
//        WHERE is_default = TRUE AND archived_at IS NULL;
//    - Row Level Security (RLS) en todas las tablas de E3:
//        ALTER TABLE <tabla_e3> ENABLE ROW LEVEL SECURITY;
//        ALTER TABLE <tabla_e3> FORCE ROW LEVEL SECURITY;
//        CREATE POLICY tenant_isolation_<tabla_e3> ON <tabla_e3>
//        FOR ALL USING (tenant_id = NULLIF(current_setting('app.current_tenant_id', true), '')::UUID)
//        WITH CHECK (tenant_id = NULLIF(current_setting('app.current_tenant_id', true), '')::UUID);
//
// 5. PUNTOS DE DECISIÓN CLAVE PARA REVISIÓN CON SQUAD 1:
//    - Propagación de Tenant ID:
//        Squad 1 definirá cómo se inyectará `app.current_tenant_id` en las conexiones del pool
//        (ej. mediante Prisma Client Extension con `$queryRawUnsafe("SET LOCAL app.current_tenant_id = ...")`
//        o AsyncLocalStorage en NestJS).
//    - Políticas de borrado (ON DELETE):
//        E3 propone `ON DELETE CASCADE` para borrado de Tenants (limpieza total), pero `ON DELETE SET NULL`
//        en las referencias de usuario en movimientos y kardex para preservar el historial auditable
//        incluso si un usuario es dado de baja en el sistema.
//    - Permisos Granulares RBAC por Bodega:
//        Revisar con Squad 1 si los roles de usuario (`WAREHOUSE_MANAGER`, etc.) requerirán una tabla intermedia
//        `user_warehouses` (manejada por E1) para autorizar accesos a nivel de bodega específica en E3.
